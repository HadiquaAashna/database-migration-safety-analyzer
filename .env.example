# MIGRATECHECK Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option 1: Direct Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/migratecheck

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=migratecheck

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
